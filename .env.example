FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
APP_ENCRYPTION_KEY=replace-with-a-second-long-random-secret
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ci_help_desk
APP_STORAGE_ROOT=runtime
DB_CONNECT_RETRIES=30
DB_CONNECT_RETRY_SECONDS=2
PORT=8080
WEB_CONCURRENCY=1
